# Copy to .env and adjust if needed
# Organization this copy is licensed to (shown on sign-in and About)
LICENSEE=

HOST_PORT=8080
SESSION_HOURS=12
KEEP_BACKUPS=14
AUTO_BACKUP_HOURS=24
TRASH_DAYS=30
MAX_UPLOAD_MB=15
AUDIT_DAYS=365

# Public address of the app (used for ticket links in emails)
APP_URL=

# ---- Email notifications (leave SMTP_HOST empty to disable) ----
# SMTP_SECURE: starttls (port 587 or 25) | tls (port 465) | none (internal relay only)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IT Help Desk <helpdesk@company.com>
# only for internal servers with a self-signed certificate
SMTP_TLS_INSECURE=false

# auto | true | false  (auto = Secure cookie for HTTPS requests via a trusted proxy)
COOKIE_SECURE=auto

# Reverse proxy IPs/CIDRs allowed to send X-Forwarded-* headers. Leave empty when no proxy.
TRUSTED_PROXIES=

# Optional: fixed first-run setup code (otherwise a random one is printed in the log)
SETUP_TOKEN=

# Only for docker-compose.cloudflare.yml
CF_TUNNEL_TOKEN=
